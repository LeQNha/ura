rules_version = '2';

// Firestore Security Rules — Phase 0 (chỉ có collection `users`).
//
// Các collection khác (observations, expeditions, missions...) sẽ được
// bổ sung rule tương ứng ở các Phase sau khi entity đó được implement.
//
// Cách áp dụng: vào Firebase Console → Firestore Database → Rules,
// dán nội dung file này vào, bấm Publish. Hoặc dùng Firebase CLI:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Ai đã đăng nhập cũng đọc được profile (để xem profile người khác,
      // hiển thị tên Contributor trên Observation...).
      allow read: if isSignedIn();

      // Chỉ chính chủ mới được tạo document của mình (lúc Register),
      // và không được tự đổi role/xp/reputation của chính mình (những
      // field này chỉ nên được thay đổi qua Cloud Function / server-side
      // logic ở các phase sau — ở Phase 0 mình chặn user tự sửa để an toàn).
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.xp == 0 &&
        request.resource.data.reputation == 0;

      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.xp == resource.data.xp &&
        request.resource.data.reputation == resource.data.reputation
        || isAdmin();

      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
